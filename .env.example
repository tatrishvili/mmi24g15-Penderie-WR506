# ============================================================================
#  .env.example — copy to .env and adjust (never commit the real .env)
#  Used by docker-compose.yml (variable substitution on the host).
# ============================================================================

# --- MariaDB ---
DB_NAME=penderie
DB_USER=penderie
DB_PASSWORD=penderie
DB_ROOT_PASSWORD=penderie-root

# --- Secrets (backend/.env holds the real values, never committed) ---
# OPENROUTER_API_KEY=

# --- Email delivery ---
# Local Docker development defaults to Mailpit. For a deployed environment:
# MAILER_DSN=resend+api://re_your_api_key@default
# MAILER_FROM_ADDRESS=no-reply@your-verified-domain.example
PUBLIC_APP_URL=http://localhost:5173
