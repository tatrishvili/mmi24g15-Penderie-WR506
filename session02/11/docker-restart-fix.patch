diff --git a/Makefile b/Makefile
index df5569f..9f4b233 100644
--- a/Makefile
+++ b/Makefile
@@ -36,8 +36,9 @@ down: ## Stop the stack (keeps the database volume)
 	$(COMPOSE) down
 
 .PHONY: restart
-restart: ## Restart the stack without rebuilding
-	$(COMPOSE) restart
+restart: ## Recreate app containers and wait for readiness (keeps database data)
+	$(COMPOSE) up -d --wait db mailpit
+	$(COMPOSE) up -d --no-deps --force-recreate --wait api nginx frontend
 
 .PHONY: ps
 ps: ## Show the status of every service
