       MAILER_FROM_ADDRESS: ${MAILER_FROM_ADDRESS:-no-reply@penderie.local}
       PUBLIC_APP_URL: ${PUBLIC_APP_URL:-http://localhost:5173}
     healthcheck:
-      test: ["CMD", "php", "-r", "exit(@fsockopen('127.0.0.1', 9000) ? 0 : 1);"]
+      test: ["CMD", "php", "-r", "exit(is_file('/var/www/html/public/index.php') && is_file('/var/www/html/vendor/autoload.php') && @fsockopen('127.0.0.1', 9000) ? 0 : 1);"]
       interval: 5s
