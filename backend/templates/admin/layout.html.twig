{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Chettan+2:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bordeaux: #73182d;
            --bordeaux-title: #631a25;
            --bordeaux-deep: #521825;
            --rose-poudre: #fad9e0;
            --rose-blush: #f8e8e5;
            --rose-sable: #eed2c4;
            --creme: #fcf7f4;
            --gris-texte: #5a4c4c;
            --gris-rose: #c88a9a;
            --white: #ffffff;
            --red: #c92a2a;
            --font: 'Baloo Chettan 2', system-ui, 'Segoe UI', Roboto, sans-serif;
            --radius-card: 20px;
            --radius-input: 12px;
            --tap: 44px;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: var(--font);
            color: var(--gris-texte);
            background: var(--creme);
        }
        a { color: var(--bordeaux); }
        .admin-header {
            background: var(--white);
            border-bottom: 1px solid var(--rose-poudre);
        }
        .admin-header__inner {
            max-width: 560px;
            margin: 0 auto;
            padding: 16px 20px 12px;
            display: grid;
            gap: 12px;
        }
        .admin-header__top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }
        .admin-header__brand {
            display: inline-flex;
            flex-direction: column;
            text-decoration: none;
            line-height: 1.05;
        }
        .admin-header__brand strong {
            font-size: 28px;
            color: var(--bordeaux);
        }
        .admin-header__brand span {
            margin-top: 2px;
            font-size: 13px;
            color: var(--gris-rose);
        }
        .admin-langs {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px;
            border: 1px solid var(--rose-poudre);
            border-radius: 999px;
            background: var(--creme);
        }
        .admin-langs a {
            min-width: 38px;
            min-height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            color: var(--bordeaux);
        }
        .admin-langs a[aria-current="true"] {
            background: var(--bordeaux);
            color: var(--white);
        }
        .admin-nav {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: none;
        }
        .admin-nav::-webkit-scrollbar { display: none; }
        .admin-nav a {
            flex: 0 0 auto;
            min-height: var(--tap);
            display: inline-flex;
            align-items: center;
            padding: 0 14px;
            border: 1px solid var(--rose-poudre);
            border-radius: 999px;
            background: var(--white);
            color: var(--bordeaux);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
        }
        .admin-nav a[aria-current="page"] {
            background: var(--bordeaux);
            border-color: var(--bordeaux);
            color: var(--white);
        }
        .admin-nav__icon {
            width: 18px;
            height: 18px;
            flex: 0 0 18px;
        }
        .admin-main {
            width: 100%;
            max-width: 560px;
            margin: 0 auto;
            padding: 20px 20px 40px;
        }
        h1 {
            margin: 0;
            font-size: 34px;
            line-height: 1.1;
            color: var(--bordeaux-title);
        }
        h2 {
            margin: 0;
            font-size: 24px;
            line-height: 1.2;
            color: var(--bordeaux-title);
        }
        h3 {
            margin: 0;
            font-size: 19px;
            line-height: 1.3;
            color: var(--bordeaux-title);
        }
        .admin-subtitle {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin: 8px 0 18px;
            font-size: 17px;
        }
        .admin-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            background: var(--rose-blush);
            color: var(--bordeaux);
            font-size: 12px;
            font-weight: 600;
        }
        .admin-flash {
            margin: 0 0 14px;
            padding: 12px 16px;
            border: 1px solid var(--rose-poudre);
            border-radius: var(--radius-input);
            background: var(--white);
        }
        .admin-flash--success {
            border-color: #9dc8a8;
            color: #285d38;
        }
        .admin-flash--error {
            border-color: #e4a6a6;
            color: var(--red);
        }
        .admin-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 18px;
        }
        .admin-card {
            width: 100%;
            min-height: 136px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 3px;
            text-align: left;
            font: inherit;
            cursor: pointer;
            background: var(--white);
            border: 1px solid var(--rose-poudre);
            border-radius: var(--radius-card);
            padding: 14px 16px;
            box-shadow: 0 8px 22px rgba(104, 31, 45, 0.06);
        }
        .admin-card:hover {
            border-color: var(--bordeaux);
            box-shadow: 0 10px 24px rgba(104, 31, 45, 0.12);
        }
        .admin-card:focus-visible {
            outline: 3px solid var(--bordeaux);
            outline-offset: 2px;
        }
        .admin-card__label {
            display: block;
            font-size: 14px;
            color: var(--gris-rose);
        }
        .admin-card__value {
            display: block;
            margin-top: 2px;
            font-size: 26px;
            line-height: 1.1;
            font-weight: 700;
            color: var(--bordeaux-title);
        }
        .admin-card__description {
            display: block;
            margin-top: 5px;
            color: var(--gris-texte);
            font-size: 13px;
            line-height: 1.25;
        }
        .admin-actions {
            display: grid;
            gap: 8px;
            min-width: 190px;
        }
        .admin-actions form {
            display: grid;
            gap: 6px;
        }
        .admin-actions label {
            display: grid;
            gap: 3px;
            color: var(--gris-rose);
            font-size: 12px;
        }
        .admin-actions select {
            min-height: 38px;
            border: 1px solid var(--rose-poudre);
            border-radius: var(--radius-input);
            padding: 5px 8px;
            background: var(--white);
            color: var(--bordeaux);
            font: inherit;
        }
        .admin-button {
            min-height: var(--tap);
            border: 1px solid var(--bordeaux);
            border-radius: 999px;
            padding: 6px 12px;
            background: var(--white);
            color: var(--bordeaux);
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }
        .admin-button:hover { background: var(--rose-blush); }
        .admin-button--danger {
            border-color: var(--red);
            color: var(--red);
        }
        .admin-button--danger:hover { background: #fff0ef; }
        .admin-pagination {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
        }
        .admin-pagination a {
            min-height: var(--tap);
            display: inline-flex;
            align-items: center;
            padding: 0 14px;
            border: 1px solid var(--rose-poudre);
            border-radius: 999px;
            background: var(--white);
            font-weight: 600;
            text-decoration: none;
        }
        .admin-pagination a:hover { background: var(--rose-blush); }
        .admin-period {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin: 0 0 18px;
        }
        .admin-period label {
            display: grid;
            gap: 4px;
            color: var(--gris-texte);
            font-size: 13px;
        }
        .admin-period select,
        .admin-period input,
        .admin-period button,
        .admin-dialog button {
            min-height: var(--tap);
            border: 1px solid var(--rose-poudre);
            border-radius: var(--radius-input);
            padding: 8px 12px;
            background: var(--white);
            color: var(--bordeaux);
            font: inherit;
        }
        .admin-period button {
            border-color: var(--bordeaux);
            border-radius: 999px;
            background: var(--bordeaux);
            color: var(--white);
            font-weight: 600;
            cursor: pointer;
        }
        .admin-period button:hover { background: var(--bordeaux-deep); }
        .admin-period :focus-visible,
        .admin-dialog button:focus-visible {
            outline: 2px solid var(--bordeaux);
            outline-offset: 2px;
        }
        .admin-dialog {
            width: min(920px, calc(100vw - 24px));
            max-height: 85vh;
            padding: 0;
            border: 1px solid var(--rose-poudre);
            border-radius: var(--radius-card);
            color: var(--gris-texte);
            box-shadow: 0 18px 60px rgba(50, 20, 30, 0.25);
        }
        .admin-dialog::backdrop { background: rgba(36, 20, 25, 0.55); }
        .admin-dialog__header {
            position: sticky;
            top: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px;
            background: var(--white);
            border-bottom: 1px solid var(--rose-poudre);
        }
        .admin-dialog__content { padding: 16px; overflow: auto; }
        .admin-dialog__section { margin-bottom: 20px; }
        .admin-dialog__section h3 { margin: 0 0 8px; color: var(--bordeaux-title); }
        .admin-chart { display: grid; gap: 7px; }
        .admin-chart__row {
            display: grid;
            grid-template-columns: minmax(70px, 120px) 1fr auto;
            align-items: center;
            gap: 8px;
            font-size: 13px;
        }
        .admin-chart__bar { height: 12px; border-radius: 999px; background: var(--rose-poudre); overflow: hidden; }
        .admin-chart__bar span { display: block; height: 100%; background: var(--bordeaux); }
        .admin-dialog .admin-table { min-width: 560px; }
        .admin-dialog__table { overflow-x: auto; }
        .admin-panel {
            background: var(--white);
            border: 1px solid var(--rose-poudre);
            border-radius: var(--radius-card);
            overflow: hidden;
            box-shadow: 0 8px 22px rgba(104, 31, 45, 0.06);
        }
        .admin-panel h2 {
            padding: 14px 20px;
            border-bottom: 1px solid var(--rose-poudre);
        }
        .admin-panel + .admin-panel { margin-top: 16px; }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }
        .admin-table th,
        .admin-table td {
            text-align: left;
            padding: 10px 16px;
            border-bottom: 1px solid var(--rose-blush);
            vertical-align: top;
        }
        .admin-table th {
            color: var(--gris-rose);
            font-weight: 600;
            background: #fffaf8;
        }
        .admin-table tr:last-child td { border-bottom: 0; }
        .muted { color: var(--gris-rose); }
        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
        .empty { padding: 16px; margin: 0; color: var(--gris-rose); }
        @media (max-width: 700px) {
            .admin-table thead { display: none; }
            .admin-table,
            .admin-table tbody,
            .admin-table tr,
            .admin-table td { display: block; width: 100%; }
            .admin-table tr {
                padding: 12px 16px;
                border-bottom: 1px solid var(--rose-blush);
            }
            .admin-table tr:last-child { border-bottom: 0; }
            .admin-table td {
                display: flex;
                justify-content: space-between;
                gap: 14px;
                padding: 4px 0;
                border: 0;
                text-align: right;
            }
            .admin-table td::before {
                content: attr(data-label);
                flex: 0 0 auto;
                color: var(--gris-rose);
                font-weight: 600;
                text-align: left;
            }
            .admin-actions {
                width: 100%;
                min-width: 0;
            }
            .admin-actions form {
                width: 100%;
            }
            .admin-actions .admin-button {
                justify-self: start;
            }
        }
        @media (min-width: 700px) and (max-width: 899px) {
            .admin-header__inner,
            .admin-main { max-width: 840px; }
        }
        @media (min-width: 900px) {
            .admin-header__inner { max-width: 1120px; padding: 18px 24px 12px; }
            .admin-main { max-width: 1120px; padding: 28px 24px 56px; }
            h1 { font-size: 44px; }
            h2 { font-size: 30px; }
            .admin-subtitle { font-size: 18px; }
            .admin-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
            .admin-card__value { font-size: 30px; }
        }
    </style>
{% endblock %}

{% block body %}
    {% set langs = {'fr': 'FR', 'en': 'EN', 'ka': 'KA'} %}
    <header class="admin-header">
        <div class="admin-header__inner">
            <div class="admin-header__top">
                <a class="admin-header__brand" href="{{ path('admin_dashboard') }}">
                    <strong>Penderie</strong>
                    <span>{{ 'admin.title'|trans }}</span>
                </a>
                <nav class="admin-langs" aria-label="{{ 'admin.language'|trans }}">
                    {% for code, label in langs %}
                        <a href="{{ path(app.request.attributes.get('_route'), (app.request.attributes.get('_route_params') ?? {})|merge({'lang': code})) }}"
                           aria-current="{{ app.request.locale == code ? 'true' : 'false' }}">{{ label }}</a>
                    {% endfor %}
                </nav>
            </div>
            <nav class="admin-nav" aria-label="{{ 'admin.nav.label'|trans }}">
                <a href="{{ path('admin_dashboard') }}" {% if app.request.attributes.get('_route') == 'admin_dashboard' %}aria-current="page"{% endif %}>
                    <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    {{ 'admin.nav.dashboard'|trans }}
                </a>
                <a href="{{ path('admin_journal') }}" {% if app.request.attributes.get('_route') == 'admin_journal' %}aria-current="page"{% endif %}>
                    <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 19V5m0 14h16M8 15l3-4 3 2 5-7"/></svg>
                    {{ 'admin.nav.journal'|trans }}
                </a>
                <a href="{{ path('admin_households') }}" {% if app.request.attributes.get('_route') == 'admin_households' %}aria-current="page"{% endif %}>
                    <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                    {{ 'admin.nav.households'|trans }}
                </a>
                <a href="{{ path('admin_users') }}" {% if app.request.attributes.get('_route') == 'admin_users' %}aria-current="page"{% endif %}>
                    <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-1a6 6 0 0 1 12 0v1zm13-9a3 3 0 1 0 0-6m1 9a5 5 0 0 1 4 5"/></svg>
                    {{ 'admin.nav.users'|trans }}
                </a>
                <a href="{{ path('admin_moderation_reports') }}" {% if app.request.attributes.get('_route') starts with 'admin_moderation_report' %}aria-current="page"{% endif %}>
                    <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3z"/><path d="M12 9v5m0 3h.01"/></svg>
                    {{ 'admin.nav.reports'|trans }}
                </a>
                <a href="/">
                    <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 19V5h16v14zM8 9h8m-8 4h8m-8 4h5"/></svg>
                    {{ 'admin.nav.product'|trans }}
                </a>
            </nav>
        </div>
    </header>
    <main class="admin-main">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <p class="admin-flash admin-flash--{{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% block admin_body %}{% endblock %}
    </main>
    <script>
        (() => {
            const locale = document.documentElement.lang || 'fr';
            const numberFormat = new Intl.NumberFormat(locale);
            const dateFormat = new Intl.DateTimeFormat(locale, {
                dateStyle: 'medium',
                timeStyle: 'short',
                timeZone: 'Europe/Paris'
            });
            document.querySelectorAll('[data-admin-number]').forEach((element) => {
                element.textContent = numberFormat.format(Number(element.dataset.adminNumber));
            });
            document.querySelectorAll('[data-admin-date]').forEach((element) => {
                const date = new Date(element.dataset.adminDate);
                if (!Number.isNaN(date.getTime())) {
                    element.textContent = dateFormat.format(date);
                }
            });
            document.querySelectorAll('form[data-admin-confirm]').forEach((form) => {
                form.addEventListener('submit', (event) => {
                    if (!window.confirm(form.dataset.adminConfirm || '')) {
                        event.preventDefault();
                    }
                });
            });
        })();
    </script>
{% endblock %}
